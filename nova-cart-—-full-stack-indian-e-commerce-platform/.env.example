# NOVA CART Environment Configuration

# Database & Supabase (Phase 3 Integration)
# Configure these to connect to your Supabase project
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Payment Gateway (Phase 7 Razorpay Test Mode)
RAZORPAY_KEY_ID="rzp_test_sampleKey123"
RAZORPAY_KEY_SECRET="your_test_secret"

# Server Port
PORT=3000

# App URL & AI Studio
APP_URL="http://localhost:3000"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
